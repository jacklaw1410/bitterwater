{
  "name": "bitterwater",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "(svelte-kit sync || echo '') && vp config",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint .",
    "format": "vp fmt .",
    "test:all": "vp test --run && vp run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ci-snapshot": "vp run docker:build && vp run docker:run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:thumbnails": "ts-node scripts/generate-thumbnails.ts"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "bits-ui": "^2.18.1",
    "heic-to": "^1.4.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/blocks": "^8.6.14",
    "@storybook/sveltekit": "^10.3.6",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.3.6",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "mdsvex": "^0.12.7",
    "playwright": "^1.59.1",
    "storybook": "^10.3.6",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.59.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vitest-browser-svelte": "^3.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "engines": {
    "node": "^24.14.1"
  },
  "packageManager": "bun@1.3.13"
}
