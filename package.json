{
  "name": "bitterwater",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "(svelte-kit sync || echo '') && vp config",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint .",
    "format": "vp fmt .",
    "test:all": "vp test --run && vp run test:e2e",
    "verify": "bun scripts/check-toolchain.ts && CI=1 vp check && CI=1 vp test --run && CI=1 vp build && echo 'verify: PASS - conformance, check, test, build (CI order)'",
    "test:e2e": "playwright test",
    "test:e2e:ci-snapshot": "vp run docker:build && vp run docker:run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:thumbnails": "ts-node scripts/generate-thumbnails.ts"
  },
  "dependencies": {
    "@techstark/opencv-js": "5.0.0-release.1",
    "bits-ui": "^2.18.1",
    "heic-to": "^1.5.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/sveltekit": "^10.5.7",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "mdsvex": "^0.12.8",
    "playwright": "^1.62.1",
    "storybook": "^10.5.7",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "ts-node": "^10.9.2",
    "typescript": "~6",
    "typescript-eslint": "^8.67.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plugin-devtools-json": "^1.1.0",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^24.19.0"
  },
  "packageManager": "bun@1.3.14"
}
